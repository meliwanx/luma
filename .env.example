# Copy to .env. Replace every replace-with-* value before starting Compose.
# Never commit .env. All credentials stay on the backend server.

# Compose: bind only to localhost by default. Complete administrator initialization
# before exposing the service publicly, and put an HTTPS reverse proxy in front.
# Recommended: docker compose up -d
# Then: docker compose exec luma python -m app.cli create-admin --username admin
# The CLI prompts twice for the password; use --password-stdin for one stdin line.
LUMA_BIND_HOST=127.0.0.1
LUMA_PORT=8000
WORKERS=2
LUMA_SERVICE_NAME=luma
THREADPOOL_SIZE=64

# PostgreSQL (required). Compose overrides host/port with the internal service.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=luma
DB_USER=luma
DB_PASSWORD=replace-with-random-database-password
DB_SCHEMA=
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=8
DB_APPLICATION_NAME=luma
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_TIMEOUT=10

# Redis (required). Compose uses requirepass and AOF persistence.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-random-redis-password
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=2
REDIS_TIMEOUT=2

# Account security (required). Compose enforces AUTH_REQUIRED=true.
AUTH_REQUIRED=true
# Generate independently: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SESSION_SECRET=replace-with-random-session-secret-at-least-32-characters
# Required for first-account API registration: an independent random token of at
# least 16 characters. Empty or shorter values block first-account registration.
# Include it as bootstrap_token in POST /api/v1/auth/register. The current web,
# Flutter, and desktop clients have no token input; use the CLI or a separate
# API request.
# Remove it after initialization. The local create-admin CLI does not need it.
AUTH_BOOTSTRAP_TOKEN=
# After initialization, registration follows open / invite / closed.
AUTH_REGISTRATION=invite
# Required for later registrations in invite mode; use a long random value.
AUTH_INVITE_CODE=replace-with-random-invitation-code
AUTH_SESSION_TTL_DAYS=7
AUTH_SESSION_MAX_DAYS=30
# Set true when using HTTPS; false is only for local HTTP setup.
AUTH_COOKIE_SECURE=false
# Comma-separated login providers. password is local accounts. sso is optional.
# Both may be enabled together, for example: sso,password
AUTH_PROVIDERS=password
# Button text for the redirect provider. Leave the default unless you need another label.
AUTH_SSO_LABEL=单点登录
# Hint for the optional account field. Do not put an organization-specific word here.
AUTH_ACCOUNT_LABEL=账号
# Required only when AUTH_PROVIDERS includes sso. Use your identity service origin.
SSO_BASE_URL=
# Optional. Defaults to SSO_BASE_URL + /api/sso/verify and /api/sso/federated-login.
SSO_VERIFY_URL=
SSO_FEDERATED_LOGIN_URL=
# Optional public origin of this app. Used only to build SSO_CALLBACK_URL.
SSO_APP_BASE_URL=
SSO_CALLBACK_URL=
# Sent as X-System-Code. assistant is the generic default.
SSO_SYSTEM_CODE=assistant
# Shared HMAC secret for the identity service. SSO_SYSTEM_SECRET is an alias.
SSO_API_SECRET=
SSO_VERIFY_TIMEOUT_SECONDS=8
# Account-password channel proxied to the identity service. true or false.
AUTH_PASSWORD_LOGIN_ENABLED=true
# Optional comma-separated additional administrator user IDs.
ADMIN_USER_IDS=

# Fernet key (required for encrypted connector credentials).
# Generate after dependencies are installed:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
LUMA_SECRETS_KEY=replace-with-generated-fernet-key

# OpenAI-compatible LLM (required for model replies, optional for local mode).
LUMA_PROVIDER=llm
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=45

# Tencent Cloud Agent Runtime (optional). User/model code runs only here.
# Keep disabled until the E2B endpoint, API key and tools are configured.
AGENT_RUNTIME_ENABLED=false
AGENT_RUNTIME_API_MODE=e2b
E2B_DOMAIN=ap-hongkong.tencentags.com
E2B_API_KEY=
# Use your provisioned tool names; AIO is optional for combined capabilities.
AGENT_RUNTIME_CODE_TOOL=your-code-tool-name
AGENT_RUNTIME_BROWSER_TOOL=your-browser-tool-name
AGENT_RUNTIME_AIO_TOOL=
AGENT_RUNTIME_IDLE_TTL_SECONDS=300
AGENT_RUNTIME_REQUEST_TIMEOUT_SECONDS=10
AGENT_RUNTIME_MAX_INSTANCES=5
AGENT_RUNTIME_MAX_CPU=10
AGENT_RUNTIME_MAX_MEMORY_GIB=10
SANDBOX_BACKUP_MAX_MB=512
SANDBOX_PAUSED_RETENTION_DAYS=30
SANDBOX_MAX_PAUSED=18
SANDBOX_PREVIEW_HOST_SUFFIX=.tencentags.com
# Optional alternative control-plane adapters; unused in the E2B setup above.
AGENT_RUNTIME_PROVIDER=tencent-agent-runtime
AGENT_RUNTIME_BASE_URL=
AGENT_RUNTIME_API_KEY=
AGENT_RUNTIME_API_VERSION=2025-09-20
AGENT_RUNTIME_REGION=ap-hongkong
AGENT_RUNTIME_CODE_TOOL_ID=
AGENT_RUNTIME_BROWSER_TOOL_ID=
AGENT_RUNTIME_CREATE_PATH=/v1/runtimes
AGENT_RUNTIME_GET_PATH=/v1/runtimes/{runtime_id}
AGENT_RUNTIME_RELEASE_PATH=/v1/runtimes/{runtime_id}
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# Files: supported backends are local / cos / fileservice (no S3 adapter).
# Compose fixes the local root inside filesdata; do not use a host path here.
FILE_STORAGE=local
ASSISTANT_FILE_ROOT=/opt/luma/backend/data/files
ASSISTANT_MAX_UPLOAD_BYTES=52428800
FILE_PURGE_AFTER_HOURS=24
# Optional Tencent COS configuration, required only with FILE_STORAGE=cos.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=your-cos-region
COS_BUCKET=
COS_PREFIX=luma/
# Optional HTTPS file-service adapter, required only with FILE_STORAGE=fileservice.
FILE_SERVICE_URL=
FILE_SERVICE_APP_KEY=
FILE_SERVICE_APP_SECRET=
FILE_SERVICE_FOLDER_ID=
FILE_SERVICE_TIMEOUT=60
FILE_SERVICE_ALLOW_HTTP=false

# Optional speech recognition; leave the API key empty to disable it.
BAILIAN_ASR_API_KEY=
BAILIAN_ASR_BASE_URL=
BAILIAN_ASR_MODEL=your-asr-model-name
BAILIAN_ASR_VOCABULARY_ID=
BAILIAN_ASR_WORKSPACE=
VOICE_ASR_TIMEOUT_SECONDS=45

# Optional push notifications. Mount credential files read-only into the container.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=

# Network boundaries. Fill blocked hosts with this server's public IP/domain.
# Use comma-separated hosts/IPs, for example 203.0.113.10 (documentation only).
MCP_BLOCKED_HOSTS=
BROWSER_BLOCKED_HOSTS=
# Comma-separated exact browser origins; replace for your deployed HTTPS origin.
CORS_ORIGINS=http://localhost:8000

# Optional generation, context and background-work limits.
GENERATION_MAX_SECONDS=600
GENERATION_HISTORY_RETENTION_SECONDS=60
MAX_CONCURRENT_GENERATIONS_PER_USER=3
CONTEXT_MAX_MESSAGES=200
CONTEXT_TOKEN_BUDGET=24000
CONTEXT_ATTACHMENT_TURNS=2
SUMMARY_TRIGGER_MESSAGES=30
MEMORY_AUTO_EXTRACT=true
MEMORY_WORKERS=2
MEMORY_MAX_PENDING=50
MEMORY_TOKEN_BUDGET=2000
MEMORY_TOP_K=12
RUNTIME_WORKER_CONCURRENCY=3
RUNTIME_JOB_STALE_SECONDS=600
AGENT_MAX_ROUNDS=8
AGENT_MAX_TOOL_CALLS=24
AGENT_TOOL_CONCURRENCY=4
AGENT_TOOL_TIMEOUT_SECONDS=60
AGENT_TOOL_RESULT_MAX_CHARS=48000

# Optional decision-model endpoint; empty endpoint disables the adapter.
DECIDER_ENDPOINT=
DECIDER_API_KEY=
DECIDER_MODEL=your-model-name
DECIDER_TIMEOUT_MS=150
DECIDER_POINTS=
